"""One SVG generation from description and PNG reference; no retries."""
import base64,json,os
from pathlib import Path
from urllib.request import Request,urlopen
from urllib.error import HTTPError,URLError
from datetime import datetime,timezone
import xml.etree.ElementTree as ET
root=Path(__file__).resolve().parents[2]
config={}
for line in (root/'.env').read_text(encoding='utf-8-sig').splitlines():
    k,sep,v=line.partition('=')
    if sep and k.strip().startswith('QUIVERAI_'):config[k.strip()]=v.strip().strip('"\'')
config.update({k:v for k,v in os.environ.items() if k.startswith('QUIVERAI_')})
key=config.get('QUIVERAI_API_KEY','')
if not key:raise SystemExit('Missing Quiver key')
family=root/'assets/monster_defaults/bandit_gang'
source=family/'png/bandit_thug-v1.png'
instructions='We are creating individual SVG character illustrations for one human bandit family in a dark fantasy tactical RPG. Establish this visual style.\nSTYLE: Expressive hand-crafted vector illustration with strong silhouettes, angular shapes, elegant curves and restrained cel shading. Finished game asset, readable on a small character card. Dangerous, cunning outlaws with worn equipment made from leather, wood and salvaged metal.\nFAMILY APPEARANCE: Adult humans with expressive faces and varied builds. Natural human skin colors and human proportions.\nPALETTE: Worn brown leather, charcoal outlines, muted ochre cloth, rust-orange metal and bone highlights.\nCOMPOSITION: Exactly one full-body character in three-quarter view on a square transparent canvas with generous margins. Entire head, feet, weapons and accessories visible. Purposeful pose communicating the role. Lighting from upper left.\nSVG: Clean editable paths, layered solid shapes and limited shading. Avoid raster images, blur, excessive gradients and tiny texture marks. No background, scenery, frame, text or platform. Keep the face complete and readable; simplify minor equipment decoration if needed.'
prompt='A human bandit thug wearing a worn leather jerkin and patched clothing. A crude axe in one hand and a small wooden shield in the other. Surly expression and a cautious fighting stance.'
payload={'model':'arrow-2','stream':False,'n':1,'max_output_tokens':65536,'instructions':instructions,'prompt':prompt,'attributes':{'viewBox':{'minX':0,'minY':0,'width':1024,'height':1024}}}
out=family/'generation_candidates'/datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')
out.mkdir(parents=True)
(out/'request.json').write_text(json.dumps(payload),encoding='utf-8')
print('One Arrow 2 generation request WITHOUT reference, requested viewBox 1024x1024, output cap 65536; no retries.',flush=True)
req=Request('https://api.quiver.ai/v1/svgs/generations',data=json.dumps(payload).encode(),headers={'Authorization':'Bearer '+key,'Content-Type':'application/json'})
try:
    with urlopen(req,timeout=600) as resp:
        raw=resp.read().decode().replace(key,'[REDACTED]');rid=resp.headers.get('X-Request-ID')
except HTTPError as e:
    (out/'error.json').write_text(e.read().decode(errors='replace').replace(key,'[REDACTED]'),encoding='utf-8')
    raise SystemExit(f'HTTP {e.code}; no retry. Details: {out}')
except (URLError,TimeoutError):raise SystemExit('Network error; no retry. Check Logs.')
(out/'response.json').write_text(raw,encoding='utf-8')
r=json.loads(raw);svg=r['data'][0]['svg'];tree=ET.fromstring(svg)
assert tree.tag=='{http://www.w3.org/2000/svg}svg'
(out/'bandit_thug.svg').write_text(svg,encoding='utf-8')
u=r.get('usage',{});report={'request_id':rid,'usage':u,'estimate_usd_uncached':(u.get('input_tokens',0)*4+u.get('output_tokens',0)*20)/1000000,'raster_image_elements':sum(e.tag.endswith('}image') for e in tree.iter()),'paths':sum(e.tag.endswith('}path') for e in tree.iter())}
(out/'usage.json').write_text(json.dumps(report,indent=2),encoding='utf-8')
print(json.dumps(report,indent=2));print('Saved:',out)
