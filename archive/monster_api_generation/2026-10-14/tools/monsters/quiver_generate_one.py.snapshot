"""Generate one review candidate with Quiver; no automatic retries."""
import argparse
import base64
import json
import os
from datetime import datetime, timezone
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen
import xml.etree.ElementTree as ET

ROOT = Path(__file__).resolve().parents[2]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--send', action='store_true', help='Make one billable request')
    parser.add_argument('--variant', default='goblin_tinkerer')
    parser.add_argument('--timeout', type=int, default=None)
    args = parser.parse_args()
    config = {}
    for line in (ROOT / '.env').read_text(encoding='utf-8-sig').splitlines():
        key, separator, value = line.partition('=')
        if separator and key.strip().startswith('QUIVERAI_'):
            config[key.strip()] = value.strip().strip('\"\'')
    config.update({k: v for k, v in os.environ.items() if k.startswith('QUIVERAI_')})
    model = config.get('QUIVERAI_MODEL', 'arrow-2')
    if model != 'arrow-2':
        raise SystemExit('This first-request tool is configured for arrow-2 only.')
    family = ROOT / 'assets/monster_defaults/goblin_tribe'
    variants = {m['variant_id'] for m in json.loads((family / 'manifest.json').read_text(encoding='utf-8'))['members']}
    if args.variant not in variants:
        raise SystemExit('Unknown variant.')
    payload = {
        'model': model, 'n': 1, 'stream': False,
        'max_output_tokens': int(config.get('QUIVERAI_MAX_OUTPUT_TOKENS', '32768')),
        'instructions': (family / 'master_prompt.txt').read_text(encoding='utf-8'),
        'prompt': (family / 'prompts' / (args.variant + '.txt')).read_text(encoding='utf-8'),
        'references': [{'base64': base64.b64encode(
            (family / 'svg/goblin_sneak.svg').read_bytes()).decode('ascii')}],
    }
    if not 1 <= payload['max_output_tokens'] <= 65536:
        raise SystemExit('max_output_tokens must be between 1 and 65536.')
    print(f'One {args.variant} candidate; reference: goblin_sneak.svg; model: arrow-2.', flush=True)
    print('Output token cap:', payload['max_output_tokens'])
    if not args.send:
        print('Dry run complete. No network requests or charges. Use --send to generate.')
        return
    key = config.get('QUIVERAI_API_KEY', '')
    if not key or key == 'PASTE_YOUR_API_KEY_HERE':
        raise SystemExit('Set QUIVERAI_API_KEY in .env first.')
    out = family / 'api_candidates' / datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')
    out.mkdir(parents=True)
    (out / 'request.json').write_text(json.dumps(payload, indent=2), encoding='utf-8')
    request = Request('https://api.quiver.ai/v1/svgs/generations',
                      data=json.dumps(payload).encode('utf-8'),
                      headers={'Authorization': 'Bearer ' + key, 'Content-Type': 'application/json'})
    try:
        with urlopen(request, timeout=args.timeout or int(config.get('QUIVERAI_TIMEOUT_SECONDS', '600'))) as response:
            raw = response.read().decode('utf-8').replace(key, '[REDACTED]')
            request_id = response.headers.get('X-Request-ID')
    except HTTPError as error:
        raw = error.read().decode('utf-8', errors='replace').replace(key, '[REDACTED]')
        (out / 'error.json').write_text(raw, encoding='utf-8')
        raise SystemExit(f'HTTP {error.code}; details saved in {out}. No retry made.')
    except (URLError, TimeoutError):
        raise SystemExit('Network error/timeout. No retry made; check Logs before another request.')
    (out / 'response.json').write_text(raw, encoding='utf-8')
    result = json.loads(raw)
    documents = result.get('data', [])
    if len(documents) != 1:
        raise SystemExit('Expected one SVG; inspect saved response. No retry made.')
    svg = documents[0]['svg']
    if ET.fromstring(svg).tag != '{http://www.w3.org/2000/svg}svg':
        raise SystemExit('Invalid SVG root; response preserved for inspection.')
    (out / (args.variant + '.svg')).write_text(svg, encoding='utf-8')
    usage = result.get('usage') or {}
    report = {'request_id': request_id, 'usage': usage, 'model': model,
              'note': 'Token estimate at public uncached rates; verify settled charge in Usage. Test keys return mocks.'}
    if 'input_tokens' in usage and 'output_tokens' in usage:
        report['estimated_usd_uncached'] = (usage['input_tokens'] * 4 + usage['output_tokens'] * 20) / 1_000_000
    (out / 'usage.json').write_text(json.dumps(report, indent=2), encoding='utf-8')
    print(json.dumps(report, indent=2))
    print('Candidate saved:', out)


if __name__ == '__main__':
    main()
